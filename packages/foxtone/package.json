{
  "name": "foxtone",
  "version": "0.1.0",
  "description": "foXerw 系列 web 应用的设计令牌系统",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/js/index.d.ts", "import": "./dist/js/index.js" },
    "./css/core.css": "./dist/css/core.css",
    "./css/themes/*": "./dist/css/themes/*",
    "./tokens.json": "./dist/tokens.json"
  },
  "scripts": {
    "build:tokens": "node build/build.mjs",
    "build:js": "tsc -p tsconfig.build.json",
    "build": "pnpm build:tokens && pnpm build:js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "culori": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "style-dictionary": "^4.3.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
