{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": { "$value": "{primitive.color.gray.950}" },
      "surface": { "$value": "{primitive.color.gray.900}" },
      "raised": { "$value": "{primitive.color.gray.800}" }
    },
    "fg": {
      "default": { "$value": "{primitive.color.gray.50}" },
      "muted": { "$value": "{primitive.color.gray.300}" },
      "subtle": { "$value": "{primitive.color.gray.500}" }
    },
    "border": {
      "default": { "$value": "{primitive.color.gray.700}" },
      "strong": { "$value": "{primitive.color.gray.500}" }
    },
    "brand": {
      "bg": { "$value": "{primitive.color.sky.500}" },
      "fg": { "$value": "{primitive.color.gray.0}" },
      "hover": { "$value": "{primitive.color.sky.400}" },
      "active": { "$value": "{primitive.color.sky.300}" }
    },
    "state": {
      "success": {
        "bg": { "$value": "{primitive.color.green.950}" },
        "fg": { "$value": "{primitive.color.green.300}" },
        "border": { "$value": "{primitive.color.green.800}" }
      },
      "warning": {
        "bg": { "$value": "{primitive.color.amber.950}" },
        "fg": { "$value": "{primitive.color.amber.300}" },
        "border": { "$value": "{primitive.color.amber.800}" }
      },
      "danger": {
        "bg": { "$value": "{primitive.color.red.950}" },
        "fg": { "$value": "{primitive.color.red.300}" },
        "border": { "$value": "{primitive.color.red.800}" }
      },
      "info": {
        "bg": { "$value": "{primitive.color.sky.950}" },
        "fg": { "$value": "{primitive.color.sky.300}" },
        "border": { "$value": "{primitive.color.sky.800}" }
      }
    }
  }
}
