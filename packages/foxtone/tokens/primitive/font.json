{
  "primitive": {
    "font": {
      "family": {
        "sans": { "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif", "$type": "fontFamily" },
        "mono": { "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace", "$type": "fontFamily" }
      },
      "size": {
        "$type": "dimension",
        "1": { "$value": "12px" }, "2": { "$value": "14px" },
        "3": { "$value": "16px" }, "4": { "$value": "18px" },
        "5": { "$value": "20px" }, "6": { "$value": "24px" },
        "7": { "$value": "30px" }, "8": { "$value": "36px" },
        "9": { "$value": "48px" }
      },
      "line-height": {
        "$type": "number",
        "tight": { "$value": 1.25 },
        "base": { "$value": 1.5 },
        "relaxed": { "$value": 1.75 }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "medium": { "$value": 500 },
        "bold": { "$value": 700 }
      }
    }
  }
}
